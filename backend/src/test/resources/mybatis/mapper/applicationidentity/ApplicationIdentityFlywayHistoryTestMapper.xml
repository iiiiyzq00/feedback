<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.integration.ApplicationIdentityFlywayHistoryTestMapper">
    <select id="countSuccessfulVersion" resultType="int">
        SELECT COUNT(*) FROM flyway_schema_history WHERE version=#{version} AND success=1
    </select>
</mapper>
