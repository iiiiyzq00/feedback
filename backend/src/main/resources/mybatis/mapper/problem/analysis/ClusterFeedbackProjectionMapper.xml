<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.problem.analysis.ClusterFeedbackProjectionMapper">
  <!-- 必须携带同一 generationId 批量读取安全正文，禁止用其他代或来源原文补齐缺失行。 -->
  <select id="findByIds" resultType="com.feedback.model.po.problem.analysis.ClusterFeedbackProjectionPo">
    SELECT source_id,source_record_id,title,description,diagnostic_types
    FROM t_phase_one_feedback_list_projection
    WHERE generation_id=#{generationId} AND source_id IN
    <foreach collection="sourceIds" item="value" open="(" separator="," close=")">#{value}</foreach>
    ORDER BY source_id
  </select>
</mapper>

