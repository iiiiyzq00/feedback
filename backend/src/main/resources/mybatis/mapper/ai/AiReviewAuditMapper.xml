<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.ai.AiReviewAuditMapper">
  <insert id="insertOne">INSERT INTO t_system_audit_log(user_id,operation,target_type,target_id,operation_detail)
    VALUES(#{reviewer},'AI_CLASSIFICATION_REVIEW','FEEDBACK',CAST(#{sourceId} AS CHAR),
    JSON_OBJECT('action',#{action},'category',#{category},'severity',#{severity}))</insert>
  <insert id="insertBatch">INSERT INTO t_system_audit_log(user_id,operation,target_type,target_id,operation_detail)
    VALUES(#{reviewer},'AI_CLASSIFICATION_BATCH_REVIEW','FEEDBACK_BATCH',#{target},
    JSON_OBJECT('action',#{action},'category',#{category},'severity',#{severity},'count',#{count},
    'sourceIds',CAST(#{idsJson} AS JSON)))</insert>
</mapper>
