<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.query.SimilarFeedbackContentMapper">
  <select id="findSafe" resultType="long">SELECT source_id FROM t_feedback_content WHERE is_deleted=0
    AND masking_status='PASS' AND source_id IN
    <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    <if test="modules != null">AND UPPER(COALESCE(function_module,'UNKNOWN')) IN
      <foreach collection="modules" item="v" open="(" separator="," close=")">#{v}</foreach></if>
  </select>
</mapper>
