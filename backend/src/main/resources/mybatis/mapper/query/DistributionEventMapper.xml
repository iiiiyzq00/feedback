<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.query.DistributionEventMapper"><insert id="insertRollback">INSERT INTO t_feedback_disposition_event(
  feedback_source_id,event_type,handler_user_id,previous_owner_user_id,new_owner_user_id,old_status,new_status,
  old_distribution_status,new_distribution_status,handoff_task_id,event_reason)
  VALUES(#{row.sourceId},'HANDOFF_ROLLED_BACK',#{row.actor},#{row.previousOwner},#{row.newOwner},'DISTRIBUTED',
  #{row.processingStatus},'PENDING_ACCEPTANCE','ROLLED_BACK',#{row.taskId},#{row.reason})</insert></mapper>
