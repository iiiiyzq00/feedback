<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.query.MetricContentMapper">
  <select id="findActive" resultType="com.feedback.model.po.query.MetricContentFactPo">SELECT source_id,masking_status
    FROM t_feedback_content WHERE is_deleted=0 AND source_id IN
    <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    <if test="modules != null">AND COALESCE(function_module,'UNKNOWN') IN
      <foreach collection="modules" item="module" open="(" separator="," close=")">#{module}</foreach></if></select>
</mapper>
