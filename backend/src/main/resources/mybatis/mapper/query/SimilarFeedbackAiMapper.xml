<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.query.SimilarFeedbackAiMapper">
  <select id="findVectorSynced" resultType="long">SELECT source_id FROM t_feedback_ai WHERE vector_index_status='SYNCED'
    AND source_id IN <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach></select>
</mapper>
