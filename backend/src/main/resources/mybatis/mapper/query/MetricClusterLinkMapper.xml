<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.query.MetricClusterLinkMapper">
  <select id="findActiveMain" resultType="com.feedback.model.po.query.MetricClusterFactPo">SELECT feedback_source_id source_id,link_type
    FROM t_cluster_link WHERE is_active=1 AND relation_role='MAIN' AND feedback_source_id IN
    <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach></select>
</mapper>
