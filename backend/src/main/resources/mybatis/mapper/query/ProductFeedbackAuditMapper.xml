<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.query.ProductFeedbackAuditMapper"><insert id="insert">INSERT INTO t_system_audit_log(
  user_id,operation,audit_class,outcome,target_type,target_id,operation_detail,detail_schema_version,event_time)
  VALUES(#{user},#{operation},'BUSINESS','SUCCESS','PRODUCT_FEEDBACK_REQUEST',#{targetId},CAST(#{detailJson} AS JSON),
  'product-feedback-v1',NOW(3))</insert></mapper>
