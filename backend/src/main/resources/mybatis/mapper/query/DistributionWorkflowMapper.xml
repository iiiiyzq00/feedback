<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.query.DistributionWorkflowMapper"><update id="rollback">UPDATE t_feedback_workflow_state
  SET processing_status=#{processing},distribution_status='ROLLED_BACK',processing_status_origin='PLATFORM_ACTION',
  status_mapping_result='MANUAL_OVERRIDE',updated_by=#{actor},updated_at=NOW(3) WHERE feedback_source_id=#{sourceId}</update></mapper>
