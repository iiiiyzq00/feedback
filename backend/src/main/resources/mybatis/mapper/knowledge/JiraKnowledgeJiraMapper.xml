<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.knowledge.JiraKnowledgeJiraMapper">
  <select id="findBySourceIds" resultType="com.feedback.model.po.knowledge.JiraKnowledgeJiraPo">SELECT source_id,
    jira_key,jira_status_raw,resolution,fix_version,comment_summary,resolved_at FROM t_channel_jira
    WHERE source_id IN <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach></select>
</mapper>
