<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.knowledge.JiraKnowledgeSourceMapper">
  <select id="findJiraIdsAfter" resultType="long">SELECT id FROM t_feedback_source
    WHERE source_channel='JIRA' AND id&gt;#{afterId} ORDER BY id LIMIT #{limit}</select>
</mapper>
