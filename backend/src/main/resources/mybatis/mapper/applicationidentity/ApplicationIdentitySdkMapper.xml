<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.applicationidentity.ApplicationIdentitySdkMapper">
    <!-- SDK 来源事实按调用方已校验的 source ID 集合批量读取，禁止逐条回查。 -->
    <select id="findBySourceIds" resultType="com.feedback.model.po.applicationidentity.ApplicationIdentitySdkPo">
        SELECT
            source_id,
            app_id,
            package_name
        FROM t_channel_sdk
        WHERE source_id IN
        <foreach collection="sourceIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
</mapper>
