<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.applicationidentity.ApplicationIdentityStationMapper">
    <!-- 站端 alias 与审核候选均使用有界批量查询，不通过跨表联查扩张身份写域。 -->
    <select id="findBySourceIds" resultType="com.feedback.model.po.applicationidentity.ApplicationIdentityStationPo">
        SELECT
            source_id,
            source_app_id,
            source_app_name
        FROM t_channel_station_feedback
        WHERE source_id IN
        <foreach collection="sourceIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>
    <select id="findCandidatesByDisplayName"
            resultType="com.feedback.model.po.applicationidentity.ApplicationIdentityStationCandidatePo">
        SELECT
            source_app_id,
            COUNT(*) item_count
        FROM t_channel_station_feedback
        WHERE source_app_name = #{displayName}
          AND source_app_id IS NOT NULL
          AND TRIM(source_app_id) &lt;&gt; ''
        GROUP BY source_app_id
        ORDER BY source_app_id
        LIMIT #{limit}
    </select>
</mapper>
