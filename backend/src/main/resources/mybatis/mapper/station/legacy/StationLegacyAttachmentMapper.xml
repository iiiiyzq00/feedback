<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.station.legacy.StationLegacyAttachmentMapper">
    <select id="findSourceIdsWithEvidence" resultType="long">
        SELECT DISTINCT source_id FROM t_feedback_attachment WHERE source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">
            #{sourceId}
        </foreach>
          AND source_kind='STATION_FEEDBACK' AND deleted_at IS NULL
    </select>
</mapper>
