<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.station.legacy.StationLegacySourceMapper">
    <sql id="columns">id,source_record_id,app_version,source_event_time,fault_occurred_at,fault_time_raw,
        fault_time_precision,fault_time_source,fault_time_resolution,source_update_time,ingest_time,public_id,
        created_at,updated_at</sql>
    <select id="findByRecordIdsForUpdate" resultType="com.feedback.model.po.station.legacy.StationLegacySourcePo">
        SELECT <include refid="columns"/> FROM t_feedback_source
        WHERE source_channel='STATION_FEEDBACK' AND source_record_id IN
        <foreach collection="recordIds" item="recordId" open="(" separator="," close=")">
            #{recordId}
        </foreach>
        ORDER BY id FOR UPDATE
    </select>
    <select id="findByIds" resultType="com.feedback.model.po.station.legacy.StationLegacySourcePo">
        SELECT <include refid="columns"/> FROM t_feedback_source
        WHERE source_channel='STATION_FEEDBACK' AND id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">
            #{sourceId}
        </foreach>
    </select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO t_feedback_source(public_id,source_channel,source_record_id,app_version,source_event_time,
          fault_occurred_at,fault_time_raw,fault_time_precision,fault_time_source,fault_time_resolution,
          source_update_time,ingest_time,created_at,updated_at)
        VALUES(#{publicId},'STATION_FEEDBACK',#{sourceRecordId},#{appVersion},#{sourceEventTime},#{faultOccurredAt},
          #{faultTimeRaw},#{faultTimePrecision},#{faultTimeSource},#{faultTimeResolution},#{sourceUpdateTime},
          #{ingestTime},#{createdAt},#{updatedAt})
    </insert>
    <update id="fillMissingAppVersion">
        UPDATE t_feedback_source SET app_version=#{appVersion},updated_at=NOW(3)
        WHERE id=#{sourceId} AND source_channel='STATION_FEEDBACK' AND (app_version IS NULL OR app_version='')
    </update>
</mapper>
