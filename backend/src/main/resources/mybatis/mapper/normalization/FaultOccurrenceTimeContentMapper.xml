<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.normalization.FaultOccurrenceTimeContentMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.normalization.FaultOccurrenceTimeContentPo">
        SELECT source_id, description
        FROM t_feedback_content
        WHERE source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">#{sourceId}</foreach>
    </select>
</mapper>
