<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.normalization.FaultOccurrenceTimeJiraMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.normalization.FaultOccurrenceTimeJiraPo">
        SELECT source_id, jira_created_at
        FROM t_channel_jira
        WHERE source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">#{sourceId}</foreach>
    </select>
</mapper>
