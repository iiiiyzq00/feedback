<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.alert.InAppAlertMapper">
    <select id="byIds" resultType="com.feedback.model.po.alert.InAppAlertPo">
        SELECT id, rule_id, fired_at, instance_status AS status, instance_severity AS severity
        FROM t_alert_instance
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
