<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.feedback.mapper.alert.AlertQueryAuditMapper"><select id="timeline" resultType="com.feedback.model.po.alert.AlertQueryAuditTimelinePo">SELECT id,created_at time,operation FROM t_system_audit_log WHERE target_type='ALERT' AND target_id=#{id}</select><insert id="insert">INSERT INTO t_system_audit_log(user_id,operation,target_type,target_id,operation_detail) VALUES(#{actor},#{operation},'ALERT',#{id},CAST(#{detail} AS JSON))</insert></mapper>
