<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.feedback.mapper.alert.EntityClosureAuditMapper"><select id="effectiveKnowledge" resultType="com.feedback.model.po.alert.ClosureAuditPo">SELECT target_id FROM t_system_audit_log WHERE target_type='KNOWLEDGE' AND operation='KNOWLEDGE_USAGE_EFFECTIVE' AND correlation_id=#{correlation} AND target_id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></select><insert id="insertClose">INSERT INTO t_system_audit_log(user_id,operation,target_type,target_id,operation_detail) VALUES(#{actor},'ENTITY_CHAIN_CLOSE','INCIDENT',#{id},JSON_OBJECT('reason',#{reason},'metricVersion','entity-closure-v1'))</insert></mapper>
