<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.feedback.mapper.alert.AlertEngineIncidentLinkMapper"><insert id="insert">INSERT INTO t_incident_alert_link(incident_id,alert_instance_id,link_status) VALUES(#{incident},#{instance},'ACTIVE')</insert><select id="activeIncident" resultType="long">SELECT incident_id FROM t_incident_alert_link WHERE alert_instance_id=#{instance} AND link_status='ACTIVE' ORDER BY id DESC LIMIT 1</select></mapper>
