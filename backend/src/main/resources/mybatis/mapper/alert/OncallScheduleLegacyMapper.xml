<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.feedback.mapper.alert.OncallScheduleLegacyMapper"><insert id="insert" useGeneratedKeys="true" keyProperty="row.id">INSERT INTO t_oncall_schedule(team_name,schedule_name,schedule_type,oncall_user_id,oncall_start,oncall_end,escalation_user_id,schedule_status,created_by) VALUES(#{row.team},#{row.name},#{row.type},#{row.userId},#{row.start},#{row.end},#{row.escalationUserId},'ACTIVE',#{row.actor})</insert><select id="lockTeam" resultType="string">SELECT team_name FROM t_oncall_schedule WHERE id=#{id} FOR UPDATE</select><update id="cancel">UPDATE t_oncall_schedule SET schedule_status='CANCELLED',version=version+1 WHERE id=#{id} AND version=#{version} AND schedule_status='ACTIVE'</update></mapper>
