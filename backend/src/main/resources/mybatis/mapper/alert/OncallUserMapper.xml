<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.feedback.mapper.alert.OncallUserMapper"><select id="countActive" resultType="int">SELECT COUNT(*) FROM t_auth_user WHERE id=#{id} AND is_active=1</select><select id="findActive" resultType="com.feedback.model.po.alert.OncallUserPo">SELECT id,display_name,username FROM t_auth_user WHERE is_active=1 AND id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></select><select id="findAll" resultType="com.feedback.model.po.alert.OncallUserPo">SELECT id,display_name,username FROM t_auth_user WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></select></mapper>
