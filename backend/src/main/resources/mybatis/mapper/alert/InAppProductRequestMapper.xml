<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.alert.InAppProductRequestMapper">
    <select id="byIds" resultType="com.feedback.model.po.alert.InAppProductRequestPo">
        SELECT id, request_no, title, created_by
        FROM t_product_feedback_request
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
