<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.alert.InAppIncidentMapper">
    <select id="byIds" resultType="com.feedback.model.po.alert.InAppIncidentPo">
        SELECT id, incident_title AS title, incident_status AS status
        FROM t_incident
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
