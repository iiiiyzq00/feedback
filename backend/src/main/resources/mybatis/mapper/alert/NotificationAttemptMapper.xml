<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.feedback.mapper.alert.NotificationAttemptMapper"><select id="next" resultType="int">SELECT COALESCE(MAX(attempt_no),0)+1 FROM t_alert_occurrence WHERE occurrence_type='DELIVERY_ATTEMPT' AND notification_id=#{id}</select><insert id="insert">INSERT INTO t_alert_occurrence(instance_id,occurrence_type,metric_code,dimension_key,notification_id,attempt_no,delivery_channel,delivery_status,window_start,window_end,duration_ms,http_status,provider_code,provider_message_id,error_type,error_summary,evaluation_snapshot,evaluation_time) VALUES(#{row.alertInstanceId},'DELIVERY_ATTEMPT','NOTIFICATION_DELIVERY',#{row.channel},#{row.notificationId},#{row.attempt},#{row.channel},#{row.status},DATE_SUB(NOW(3),INTERVAL #{row.durationMicros} MICROSECOND),NOW(3),#{row.durationMs},#{row.httpStatus},#{row.providerCode},#{row.providerMessageId},#{row.errorType},#{row.errorSummary},JSON_OBJECT('notificationId',#{row.notificationId},'attemptNo',#{row.attempt}),NOW(3))</insert></mapper>
