<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.alert.InAppAssignmentMapper">
    <select id="owners" resultType="com.feedback.model.po.alert.InAppAssignmentPo">
        SELECT feedback_source_id AS feedback_id, owner_user_id AS owner_id
        FROM t_feedback_assignment
        WHERE feedback_source_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
