<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.feedback.mapper.alert.NotificationDispatchMapper"><insert id="insert">INSERT INTO t_alert_notification(record_type,rule_id,rule_code,alert_instance_id,notify_channel,policy_version,delivery_mode,notify_recipients,notify_content,notify_status,retry_count) VALUES('NOTIFICATION',#{row.ruleId},#{row.ruleCode},#{row.instanceId},#{row.channel},#{row.policyVersion},#{row.mode},CAST(#{row.recipientsJson} AS JSON),#{row.content},'PENDING',0)</insert><select id="digestExists" resultType="int">SELECT COUNT(*) FROM t_alert_notification WHERE record_type='NOTIFICATION' AND rule_code='P3_DAILY_DIGEST' AND created_at&gt;=CURDATE()</select><insert id="insertDigest">INSERT INTO t_alert_notification(record_type,rule_code,alert_instance_id,notify_channel,policy_version,delivery_mode,notify_recipients,notify_content,notify_status,retry_count) VALUES('NOTIFICATION','P3_DAILY_DIGEST',NULL,'IN_APP','v1','DAILY_DIGEST',JSON_ARRAY(),#{content},'PENDING',0)</insert><select id="sourceDelivered" resultType="int">SELECT COUNT(*) FROM t_alert_notification WHERE record_type='NOTIFICATION' AND alert_instance_id=#{instance} AND notify_channel=#{channel} AND notify_status='DELIVERED' AND COALESCE(JSON_UNQUOTE(JSON_EXTRACT(notify_content,'$.eventType')),event_type,'') IN ('ALERT_FIRED','ALERT_ESCALATION')</select></mapper>
