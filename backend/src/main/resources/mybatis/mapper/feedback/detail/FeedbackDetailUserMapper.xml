<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.detail.FeedbackDetailUserMapper">
    <select id="findByIds" resultType="com.feedback.model.po.feedback.detail.FeedbackDetailUserPo">
        SELECT id, display_name, username FROM t_auth_user WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>

