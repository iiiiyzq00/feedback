<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.detail.FeedbackDetailIdentityMapper">
    <select id="findTypes" resultType="string">
        SELECT DISTINCT identity_type FROM t_feedback_identity
        WHERE source_id = #{sourceId} ORDER BY identity_type
    </select>
</mapper>

