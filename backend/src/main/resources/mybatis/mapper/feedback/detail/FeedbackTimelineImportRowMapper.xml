<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.detail.FeedbackTimelineImportRowMapper">
    <select id="findFirstBySourceId" resultType="com.feedback.model.po.feedback.detail.FeedbackTimelineImportRowPo">
        SELECT id, feedback_source_id, sheet_name, `row_number`
        FROM t_import_row
        WHERE feedback_source_id = #{sourceId}
        ORDER BY id
        LIMIT 1
    </select>
</mapper>

