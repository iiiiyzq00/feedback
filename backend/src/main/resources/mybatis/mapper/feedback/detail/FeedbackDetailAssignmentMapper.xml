<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.detail.FeedbackDetailAssignmentMapper">
    <select id="findBySourceId" resultType="com.feedback.model.po.feedback.detail.FeedbackDetailAssignmentPo">
        SELECT feedback_source_id, owner_user_id, assignment_version, assigned_at
        FROM t_feedback_assignment WHERE feedback_source_id = #{sourceId}
    </select>
</mapper>

