<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.listprojection.FeedbackListAssignmentFactsMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.feedback.listprojection.FeedbackListAssignmentFactsPo">
        SELECT feedback_source_id,owner_user_id,updated_at FROM t_feedback_assignment WHERE feedback_source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">#{sourceId}</foreach>
    </select>
</mapper>

