<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.listprojection.FeedbackListAiFactsMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.feedback.listprojection.FeedbackListAiFactsPo">
        SELECT source_id,ai_severity,review_status,updated_at FROM t_feedback_ai WHERE source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">#{sourceId}</foreach>
    </select>
</mapper>

