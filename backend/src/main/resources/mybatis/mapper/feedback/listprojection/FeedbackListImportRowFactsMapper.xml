<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.listprojection.FeedbackListImportRowFactsMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.feedback.listprojection.FeedbackListImportRowFactsPo">
        SELECT feedback_source_id,batch_id,updated_at FROM t_import_row
        WHERE record_type='ROW' AND feedback_source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">#{sourceId}</foreach>
    </select>
</mapper>

