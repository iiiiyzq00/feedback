<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.listprojection.FeedbackListHandoffFactsMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.feedback.listprojection.FeedbackListHandoffFactsPo">
        SELECT feedback_source_id,MAX(task_status='DELIVERED') AS pending,MAX(created_at) AS updated_at
        FROM t_feedback_handoff_task WHERE feedback_source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">#{sourceId}</foreach>
        GROUP BY feedback_source_id
    </select>
</mapper>

