<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.listprojection.FeedbackListIdentityTypeFactsMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.feedback.listprojection.FeedbackListIdentityTypeFactsPo">
        SELECT DISTINCT source_id,identity_type
        FROM t_feedback_identity WHERE source_id IN
        <foreach collection="sourceIds" item="sourceId" open="(" separator="," close=")">#{sourceId}</foreach>
    </select>
</mapper>

