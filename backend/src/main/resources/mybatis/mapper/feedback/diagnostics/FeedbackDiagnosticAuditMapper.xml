<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.feedback.diagnostics.FeedbackDiagnosticAuditMapper">
  <!-- detailJson 仅含用途类别/摘要/长度、types、visibility；用途原文、诊断值和一次性令牌禁止进入审计。 -->
  <insert id="insertViewAudit">
    INSERT INTO t_system_audit_log(user_id,operation,audit_class,outcome,target_type,target_id,operation_detail,
      detail_schema_version,ip_address,event_time)
    VALUES(#{userId},'FEEDBACK_DIAGNOSTICS_VIEW','SECURITY','SUCCESS','FEEDBACK_DIAGNOSTICS',#{targetId},
      CAST(#{detailJson} AS JSON),'diag-access-v1',#{ipAddress},NOW(3))
  </insert>
  <insert id="insertViewAudits">
    INSERT INTO t_system_audit_log(user_id,operation,audit_class,outcome,target_type,target_id,operation_detail,
      detail_schema_version,ip_address,event_time)
    VALUES
    <foreach collection="rows" item="row" separator=",">
      (#{row.userId},'FEEDBACK_DIAGNOSTICS_VIEW','SECURITY','SUCCESS','FEEDBACK_DIAGNOSTICS',#{row.targetId},
       CAST(#{row.detailJson} AS JSON),'diag-access-v1',#{row.ipAddress},NOW(3))
    </foreach>
  </insert>
</mapper>

