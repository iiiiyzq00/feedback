<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.sdk.SdkTransportTelemetryMapper">
    <insert id="insertTransportEvent" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_system_audit_log(operation,target_type,target_id,operation_detail,ip_address)
        VALUES('SDK_TELEMETRY','SDK_TRANSPORT',#{targetId},CAST(#{detailJson} AS JSON),#{ipAddress})
    </insert>
    <insert id="insertTransportEvents">
        INSERT INTO t_system_audit_log(operation,target_type,target_id,operation_detail,ip_address)
        VALUES
        <foreach collection="rows" item="row" separator=",">
            ('SDK_TELEMETRY','SDK_TRANSPORT',#{row.targetId},CAST(#{row.detailJson} AS JSON),#{row.ipAddress})
        </foreach>
    </insert>
</mapper>
