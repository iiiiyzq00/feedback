<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportFactImportRowMapper">
    <select id="failedCounts" resultType="com.feedback.model.po.report.ReportFactImportFailurePo">
        SELECT batch_id, COUNT(*) AS count FROM t_import_row
        WHERE row_status = 'FAILED' AND batch_id IN
        <foreach collection="batchIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        GROUP BY batch_id
    </select>
</mapper>
