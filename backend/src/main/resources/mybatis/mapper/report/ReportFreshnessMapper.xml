<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportFreshnessMapper">
  <select id="latestByChannels" resultType="com.feedback.model.po.report.ReportChannelFreshnessPo">
    SELECT source_channel,MAX(ingest_time) latest FROM t_feedback_source WHERE source_channel IN
    <foreach collection="channels" item="channel" open="(" separator="," close=")">#{channel}</foreach>
    GROUP BY source_channel
  </select>
</mapper>
