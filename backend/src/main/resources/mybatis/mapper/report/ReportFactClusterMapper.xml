<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportFactClusterMapper">
    <select id="byIds" resultType="com.feedback.model.po.report.ReportFactClusterPo">
        SELECT id, cluster_name AS title FROM t_cluster WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
