<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportFactClusterLinkMapper">
    <select id="activeBySourceIds" resultType="com.feedback.model.po.report.ReportFactClusterLinkPo">
        SELECT feedback_source_id AS source_id, cluster_id, relation_role
        FROM t_cluster_link WHERE is_active = 1 AND feedback_source_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY id
    </select>
</mapper>
