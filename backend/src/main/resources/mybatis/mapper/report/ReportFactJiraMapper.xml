<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportFactJiraMapper">
    <select id="bySourceIds" resultType="com.feedback.model.po.report.ReportFactJiraPo">
        SELECT source_id, jira_status_raw AS status, project_key, resolved_at
        FROM t_channel_jira WHERE source_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
