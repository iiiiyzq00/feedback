<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportFactConfigMapper">
    <select id="latestActive" resultType="com.feedback.model.po.report.ReportFactConfigPo">
        SELECT config_value AS value FROM t_system_config
        WHERE config_key = #{key} AND is_active = 1 ORDER BY id DESC LIMIT 1
    </select>
</mapper>
