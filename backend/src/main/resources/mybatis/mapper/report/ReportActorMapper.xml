<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportActorMapper">
    <select id="active" resultType="com.feedback.model.po.report.ReportActorPo">
        SELECT id, username, display_name, auth_version
        FROM t_auth_user WHERE id = #{id} AND is_active = 1
    </select>
</mapper>
