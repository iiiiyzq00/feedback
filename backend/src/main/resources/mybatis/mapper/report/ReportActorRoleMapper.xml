<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportActorRoleMapper">
    <select id="active" resultType="string">
        SELECT role_code FROM t_auth_user_role
        WHERE user_id = #{id} AND (expires_at IS NULL OR expires_at &gt; NOW())
    </select>
</mapper>
