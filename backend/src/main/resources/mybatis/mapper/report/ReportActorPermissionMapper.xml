<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportActorPermissionMapper">
    <select id="byRoles" resultType="string">
        SELECT DISTINCT permission_code FROM t_auth_role_permission
        WHERE role_code IN
        <foreach collection="roles" item="role" open="(" separator="," close=")">#{role}</foreach>
    </select>
</mapper>
