<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ClusterReportIdentityMapper">
    <select id="byIds" resultType="com.feedback.model.po.report.ClusterReportIdentityPo">
        SELECT source_id, identity_scope AS scope, identity_type AS type,
               fingerprint_key_id AS key_id, fingerprint
        FROM t_feedback_identity WHERE source_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
