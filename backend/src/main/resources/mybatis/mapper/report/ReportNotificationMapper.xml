<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ReportNotificationMapper">
    <select id="idsByReport" resultType="long">
        SELECT id FROM t_alert_notification
        WHERE report_id = #{id} AND id &gt; #{after}
        ORDER BY id LIMIT #{limit}
    </select>
    <delete id="deleteByReport">DELETE FROM t_alert_notification WHERE report_id = #{id}</delete>
</mapper>
