<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.report.ClusterReportIncidentMapper">
    <select id="byIds" resultType="com.feedback.model.po.report.ClusterReportIncidentPo">
        SELECT id, incident_severity AS level, incident_title AS title,
               incident_status AS status, opened_at AS triggered_at
        FROM t_incident WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </select>
</mapper>
