<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.scheduler.MaintenanceUploadChunkMapper">
    <delete id="deleteBySessionIds">
        DELETE FROM t_import_upload_chunk
        WHERE compact_session_id IN
        <foreach collection="sessionIds" item="id" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>
