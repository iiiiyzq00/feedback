<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.scheduler.MaintenanceAlertInstanceMapper">
    <select id="activeFeedbackSourceIds" resultType="long">
        SELECT feedback_source_id
        FROM t_alert_instance
        WHERE feedback_source_id IN
        <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
          AND instance_status IN ('FIRING', 'ACKNOWLEDGED')
        FOR SHARE
    </select>
</mapper>
