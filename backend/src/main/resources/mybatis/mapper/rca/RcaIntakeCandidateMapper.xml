<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.rca.RcaIntakeCandidateMapper">

    <!--
      接入候选：按来源 ID 游标推进，一次取齐组装 RawFeedbackSignal 所需的列。

      三条 JOIN 口径都是刻意的：

      1. `t_feedback_content` 用 **INNER JOIN** 且带 `masking_status='PASS' AND is_deleted=0`。
         没脱敏通过的内容不能进证据账本——用 INNER 而不是 LEFT，是为了让「内容行缺失」
         与「内容未通过脱敏」在这里都表现为「取不出来」，而不是取出来一个 masking_status 为 NULL
         的行再靠上层判断。脱敏是门禁，不是过滤选项。

      2. `t_feedback_primary_problem_fact` 用 **LEFT JOIN**。应用身份未解析（UNRESOLVED/AMBIGUOUS）
         是正常状态，不是异常：此时应用标识取不到，上层按 UNKNOWN 处理。用 INNER 会把这些来源
         整条丢掉，表现为「接入数比来源数少」，而少的那部分恰好是身份链路还没跑完的数据。

      3. `data_environment` 进 WHERE 而不是取出来再过滤。默认 PRODUCTION 时，
         带 fixture_tag 的 TEST/VERIFICATION 行在数据库层就选不出来，
         所以「夹具不进生产证据账本」不依赖任何一处上层代码记得判断。

      4. 租户**现算**：`t_feedback_source` 没有租户列（见 V245 第 4 节），
         租户取自该来源解析到的应用身份，即上面第 2 条那条 LEFT JOIN 再向左接一次
         `t_application_identity`。**必须沿用同一个 `p`，不能自己再 join 一次事实表** ——
         两处独立取事实行会在「事实行正好被影子批次改掉」的窗口里读到两个不同答案，
         而租户是 `uk_episode_partition` 的组成部分，读飘了会把一批证据并进错误的问题对象。
         未解析时 `ai.tenant_key` 为 NULL，COALESCE 退到 'DEFAULT'（迁移期兼容租户，
         与 V245 各列默认值同义），不是「无租户」。

      没有 `SELECT *`，没有 `${}` 拼接，返回类型是具体的 PO 而不是裸 Map——
      这三条同时是 MyBatisBindingGateTest 的门禁要求。
    -->
    <select id="findIntakeCandidatesAfter" resultType="com.feedback.model.po.rca.RcaIntakeCandidatePo">
        SELECT s.id                AS source_id,
               s.source_channel    AS source_channel,
               s.source_record_id  AS source_record_id,
               s.source_event_time AS source_event_time,
               s.app_version       AS app_version,
               COALESCE(ai.tenant_key, 'DEFAULT') AS tenant_key,
               c.problem_type      AS problem_type,
               c.title             AS content_title,
               c.description       AS content_description,
               LOWER(HEX(p.application_public_id_snapshot)) AS app_public_id_hex
        FROM t_feedback_source s
        JOIN t_feedback_content c
          ON c.source_id = s.id
         AND c.masking_status = 'PASS'
         AND c.is_deleted = 0
        LEFT JOIN t_feedback_primary_problem_fact p
          ON p.feedback_source_id = s.id
        LEFT JOIN t_application_identity ai
          ON ai.id = p.application_identity_id
        WHERE s.id &gt; #{afterSourceId}
          AND s.data_environment = #{dataEnvironment}
        ORDER BY s.id
        LIMIT #{limit}
    </select>

</mapper>
