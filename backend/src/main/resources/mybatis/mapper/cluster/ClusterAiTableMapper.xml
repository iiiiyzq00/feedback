<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.cluster.ClusterAiTableMapper">
    <select id="findByIds" resultType="com.feedback.model.po.cluster.ClusterAiPo">
        SELECT source_id, ai_summary, ai_confidence, review_status
        FROM t_feedback_ai WHERE source_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY source_id
    </select>
</mapper>

