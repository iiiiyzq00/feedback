<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.cluster.ClusterRedblackContextTableMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.cluster.ClusterRedblackContextPo">
        SELECT source_id, source_platform FROM t_channel_redblack WHERE source_id IN
        <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY source_id
    </select>
</mapper>

