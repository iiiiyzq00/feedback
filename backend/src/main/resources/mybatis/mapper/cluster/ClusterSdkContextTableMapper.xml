<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.cluster.ClusterSdkContextTableMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.cluster.ClusterSdkContextPo">
        SELECT source_id, package_name, app_id, os_version, device_model
        FROM t_channel_sdk WHERE source_id IN
        <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY source_id
    </select>
</mapper>

