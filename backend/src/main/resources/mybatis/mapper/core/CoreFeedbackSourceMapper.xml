<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.core.CoreFeedbackSourceMapper">
  <sql id="columns">id,public_id,source_channel,source_record_id,app_version,package_name,source_event_time,
    fault_occurred_at,fault_time_raw,fault_time_precision,fault_time_source,fault_time_resolution,
    source_update_time,ingest_time,import_batch_id,province_code,city_code,district_code,created_at,updated_at</sql>
  <select id="findById" resultType="com.feedback.model.feedback.FeedbackSource">SELECT <include refid="columns"/>
    FROM t_feedback_source WHERE id=#{id}</select>
  <select id="findByIds" resultType="com.feedback.model.feedback.FeedbackSource">SELECT <include refid="columns"/>
    FROM t_feedback_source WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    ORDER BY id</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="row.id">INSERT INTO t_feedback_source(public_id,source_channel,
    source_record_id,app_version,package_name,source_event_time,fault_occurred_at,fault_time_raw,fault_time_precision,
    fault_time_source,fault_time_resolution,source_update_time,ingest_time,import_batch_id,province_code,city_code,
    district_code,created_at,updated_at) VALUES(#{row.publicId},#{row.sourceChannel},#{row.sourceRecordId},#{row.appVersion},
    #{row.packageName},#{row.sourceEventTime},#{row.faultOccurredAt},#{row.faultTimeRaw},#{row.faultTimePrecision},
    #{row.faultTimeSource},#{row.faultTimeResolution},#{row.sourceUpdateTime},#{row.ingestTime},#{row.importBatchId},
    #{row.provinceCode},#{row.cityCode},#{row.districtCode},#{row.createdAt},#{row.updatedAt})</insert>
  <update id="update">UPDATE t_feedback_source SET public_id=#{row.publicId},source_channel=#{row.sourceChannel},
    source_record_id=#{row.sourceRecordId},app_version=#{row.appVersion},package_name=#{row.packageName},
    source_event_time=#{row.sourceEventTime},fault_occurred_at=#{row.faultOccurredAt},fault_time_raw=#{row.faultTimeRaw},
    fault_time_precision=#{row.faultTimePrecision},fault_time_source=#{row.faultTimeSource},
    fault_time_resolution=#{row.faultTimeResolution},source_update_time=#{row.sourceUpdateTime},ingest_time=#{row.ingestTime},
    import_batch_id=#{row.importBatchId},province_code=#{row.provinceCode},city_code=#{row.cityCode},
    district_code=#{row.districtCode},updated_at=#{row.updatedAt} WHERE id=#{row.id}</update>
  <select id="findByChannelRecord" resultType="com.feedback.model.feedback.FeedbackSource">SELECT <include refid="columns"/>
    FROM t_feedback_source WHERE source_channel=#{channel} AND source_record_id=#{recordId} ORDER BY id LIMIT 1</select>
  <select id="findByChannelTime" resultType="com.feedback.model.feedback.FeedbackSource">SELECT <include refid="columns"/>
    FROM t_feedback_source WHERE source_channel=#{channel} AND source_event_time BETWEEN #{start} AND #{end}
    ORDER BY source_event_time,id</select>
  <select id="countByChannel" resultType="long">SELECT COUNT(*) FROM t_feedback_source WHERE source_channel=#{channel}</select>
  <select id="findByImportBatchId" resultType="com.feedback.model.feedback.FeedbackSource">SELECT <include refid="columns"/>
    FROM t_feedback_source WHERE import_batch_id=#{importBatchId} ORDER BY id</select>
</mapper>
