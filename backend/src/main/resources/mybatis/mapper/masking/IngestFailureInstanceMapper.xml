<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.masking.IngestFailureInstanceMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_alert_instance(rule_id,rule_code,feedback_source_id,instance_status,instance_severity,fired_at)
        VALUES(#{ruleId},'INGEST_PROCESSING_FAILED',#{feedbackSourceId},'FIRING',#{severity},CURRENT_TIMESTAMP(3))
    </insert>
</mapper>
