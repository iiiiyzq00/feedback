<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.masking.MaskingRecoveryClusterLinkMapper">
  <select id="findActiveMainSourceIds" resultType="long">SELECT DISTINCT feedback_source_id FROM t_cluster_link
    WHERE is_active=1 AND relation_role='MAIN' AND feedback_source_id IN
    <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach></select>
</mapper>
