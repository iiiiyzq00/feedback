<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.masking.IngestFailureIncidentMapper">
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_incident(public_id,incident_title,incident_status,incident_severity)
        VALUES(#{publicId},#{title},'OPEN',#{severity})
    </insert>
</mapper>
