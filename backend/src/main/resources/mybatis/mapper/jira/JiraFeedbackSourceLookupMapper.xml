<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.jira.JiraFeedbackSourceLookupMapper">
  <select id="findJiraSourceId" resultType="long">SELECT id FROM t_feedback_source WHERE source_channel='JIRA' AND source_record_id=#{jiraKey} LIMIT 1</select>
</mapper>
