<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.jira.owner.JiraOwnerAssigneeMapper">
    <select id="findBySourceIds" resultType="com.feedback.model.po.jira.owner.JiraOwnerAssigneePo">
        SELECT source_id,assignee FROM t_channel_jira WHERE source_id IN
        <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY source_id FOR UPDATE
    </select>
</mapper>
