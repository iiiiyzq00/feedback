<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.jira.owner.JiraOwnerSourceMapper">
    <select id="findPageAfterId" resultType="com.feedback.model.po.jira.owner.JiraOwnerSourcePo">
        SELECT id FROM t_feedback_source
        WHERE source_channel='JIRA' AND id&gt;#{afterSourceId}
        ORDER BY id LIMIT #{limit}
    </select>
    <select id="findJiraByIds" resultType="com.feedback.model.po.jira.owner.JiraOwnerSourcePo">
        SELECT id FROM t_feedback_source WHERE source_channel='JIRA' AND id IN
        <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach>
        ORDER BY id
    </select>
</mapper>
