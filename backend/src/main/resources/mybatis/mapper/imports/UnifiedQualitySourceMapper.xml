<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.imports.UnifiedQualitySourceMapper"><sql id="c">id,source_channel,source_record_id,source_event_time,package_name,app_version</sql><select id="findByChannel" resultType="com.feedback.model.po.imports.UnifiedQualitySourcePo">SELECT <include refid="c"/> FROM t_feedback_source WHERE source_channel=#{channel}</select><select id="findByIds" resultType="com.feedback.model.po.imports.UnifiedQualitySourcePo">SELECT <include refid="c"/> FROM t_feedback_source WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach></select></mapper>
