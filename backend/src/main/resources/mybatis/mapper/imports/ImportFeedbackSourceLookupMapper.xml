<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.imports.ImportFeedbackSourceLookupMapper">
  <select id="findJiraIdsByKeys" resultType="long">SELECT id FROM t_feedback_source WHERE source_channel='JIRA' AND source_record_id IN <foreach collection="keys" item="key" open="(" separator="," close=")">#{key}</foreach> ORDER BY id</select>
</mapper>
