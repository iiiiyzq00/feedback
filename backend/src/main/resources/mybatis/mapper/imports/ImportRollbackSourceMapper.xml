<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.imports.ImportRollbackSourceMapper">
  <select id="findByBatchId" resultType="com.feedback.model.po.imports.ImportRollbackSourcePo">SELECT id,source_channel FROM t_feedback_source WHERE import_batch_id=#{batchId} ORDER BY id</select>
  <select id="findByIds" resultType="com.feedback.model.po.imports.ImportRollbackSourcePo">SELECT id,source_channel FROM t_feedback_source WHERE id IN <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach> ORDER BY id</select>
</mapper>
