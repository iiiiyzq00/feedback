<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.imports.ImportReconciliationContentMapper"><select id="findPassingBySourceIds" resultType="com.feedback.model.po.imports.ImportReconciliationContentPo">SELECT source_id,title,description,masking_status,processing_status FROM t_feedback_content WHERE source_id IN <foreach collection="sourceIds" item="id" open="(" separator="," close=")">#{id}</foreach> AND masking_status='PASS'</select></mapper>
