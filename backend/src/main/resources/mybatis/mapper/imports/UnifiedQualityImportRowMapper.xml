<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.feedback.mapper.imports.UnifiedQualityImportRowMapper"><sql id="c">id,batch_id,business_key_hash,row_status,feedback_source_id</sql><select id="findObserved" resultType="com.feedback.model.po.imports.UnifiedQualityImportRowPo">SELECT <include refid="c"/> FROM t_import_row WHERE record_type='ROW' AND batch_id IN <foreach collection="batchIds" item="id" open="(" separator="," close=")">#{id}</foreach></select><select id="findCurrentCandidates" resultType="com.feedback.model.po.imports.UnifiedQualityImportRowPo">SELECT <include refid="c"/> FROM t_import_row WHERE record_type='ROW' AND row_status NOT IN ('SKIPPED_DUPLICATE','SKIPPED_STALE') AND batch_id IN <foreach collection="batchIds" item="id" open="(" separator="," close=")">#{id}</foreach></select><select id="findByBusinessHashes" resultType="com.feedback.model.po.imports.UnifiedQualityImportRowPo">SELECT <include refid="c"/> FROM t_import_row WHERE business_key_hash IN <foreach collection="hashes" item="hash" open="(" separator="," close=")">#{hash}</foreach></select></mapper>
