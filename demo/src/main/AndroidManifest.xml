<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 企业/MDM 部署会授予该 usage app-op；未授予时运行时降级为显式宿主身份。 -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- 通用企业版浮层必须能识别任意前台学习应用；本 APK 不通过 Play 分发。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.REORDER_TASKS" />

    <application
        android:name=".DemoApplication"
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="通用反馈"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        android:usesCleartextTraffic="false">

        <!-- 学习机横屏：锁定 landscape，阻止竖屏旋转 -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|screenLayout"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".universal.UniversalTriggerActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="feedback" android:host="open" />
            </intent-filter>
        </activity>

        <activity
            android:name=".universal.UniversalFeedbackActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="${feedbackTaskAffinity}"
            android:configChanges="orientation|screenSize|screenLayout|density|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".universal.ScreenCapturePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".SecureTestActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <service
            android:name=".universal.UniversalFeedbackOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="enterprise learning-device universal feedback overlay" />
        </service>
        <service
            android:name=".universal.ScreenCaptureSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
