{
  "name": "feedback-platform-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <27",
    "npm": ">=10"
  },
  "description": "学习机反馈平台 v6.0 前端 - Vue 3 + TypeScript + Element Plus + ECharts",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/check-build-budgets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.0",
    "@tanstack/vue-query": "^5.101.4",
    "axios": "^1.19.0",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.4",
    "pinia": "^2.1.0",
    "vue": "^3.5.41",
    "vue-echarts": "^8.1.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.6.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "unplugin-element-plus": "^0.11.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.0.0"
  }
